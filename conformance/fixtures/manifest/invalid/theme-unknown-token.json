  "id": "com.example.bad-theme",
  "name": "Bad Theme",
  "version": "0.1.0",
  "manifestVersion": "0.15",
  "facets": {
    "host": { "entry": "dist/host.js", "apiVersion": "v1alpha1" }
  },
  "contributes": {
    "themes": [
      {
        "id": "com.example.bad-theme.dark",
        "title": "Bad Dark",
        "tokens": { "--dsw-bg": "#101418", "accent": "#ff0000" }
