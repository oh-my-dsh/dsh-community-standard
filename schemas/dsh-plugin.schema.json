{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-std.example/schemas/dsh-plugin/v0.15.json",
  "$comment": "字段语义以 spec/manifest.md 为唯一权威来源，本文件不得出现 spec 未定义的规则。$id 为示意，以 Registry 定案为准。",
  "title": "dsh-plugin.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "name", "version", "manifestVersion", "facets"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "canonical schema identifier；宿主据此选择本地 schema，不从网络获取。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$",
      "description": "插件全局唯一 ID，小写反向域名语法，至少两段。"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "插件自身的 SemVer 版本。"
    },
    "manifestVersion": {
      "const": "0.15",
      "description": "必须与 $schema 选中的 schema 版本一致，不能成为另一个协商轴。"
    },
    "facets": {
      "type": "object",
      "required": ["host"],
      "propertyNames": { "not": { "enum": ["client", "worker"] } },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry", "apiVersion"],
        "properties": {
          "entry": {
            "type": "string",
            "minLength": 1,
            "description": "入口文件，必须位于 package 根目录内。"
          },
          "apiVersion": {
            "type": "string",
            "minLength": 1,
            "description": "该 facet 要求的 Host API 版本。"
          }
        }
      },
      "description": "v0.15 必须包含 host facet；client / worker 为保留名（归 RFC 0002），出现即拒绝。"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["apiVersion", "kind"],
            "properties": {
              "apiVersion": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "optional": { "type": "boolean", "default": false }
            }
          }
        }
      },
      "description": "v0.15 只接受 requires.contracts；requires.services 被拒绝（归 RFC 0003）。"
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "契约坐标之外的敏感 scope；v0.15 尚未标准化任何独立 scope，通常为空数组。"
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "全局唯一，应该以插件 id 为前缀。"
              },
              "title": { "type": "string", "minLength": 1 }
            }
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "location"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$",
                "description": "全局唯一，小写反向域名语法，应该以插件 id 为前缀。"
              },
              "title": { "type": "string", "minLength": 1 },
              "location": {
                "type": "string",
                "enum": [
                  "conversation.tab",
                  "details.panel",
                  "sidebar.footer",
                  "settings.section",
                  "settings.item",
                  "input.left",
                  "input.right",
                  "composer.dock",
                  "shell.overlay",
                  "chat.commandview",
                  "chat.node",
                  "tool.view"
                ],
                "description": "视图位置，扁平字符串；插件不得声明此枚举之外的位置。"
              },
              "priority": {
                "enum": ["high", "normal", "low"],
                "default": "normal",
                "description": "list 型位置的排布优先级；禁止数字 order 字段（additionalProperties: false 直接拒绝）。"
              },
              "when": {
                "enum": ["root", "session"],
                "description": "作用域：root（应用级）或 session（会话级）。"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "description": "keyed 位置（chat.commandview / chat.node / tool.view）的分发键。"
              },
              "component": {
                "type": "string",
                "minLength": 1,
                "description": "富组件 bundle，包内相对路径；与 static 二选一。"
              },
              "static": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": { "type": "string" }
                },
                "description": "纯声明视图内容（标题 + 静态文本）；与 component 二选一。"
              }
            },
            "oneOf": [
              { "required": ["component"] },
              { "required": ["static"] }
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "location": { "enum": ["chat.commandview", "chat.node", "tool.view"] }
                  },
                  "required": ["location"]
                },
                "then": { "required": ["key"] }
              }
            ]
          },
          "description": "视图贡献（RFC 0005）：component 与 static 由 oneOf 强制二选一；keyed 位置缺 key 由 if/then 在 schema 层拒绝。"
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "title", "schema"],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$",
                "description": "设置命名空间，小写反向域名语法，应该以插件 id 为前缀。"
              },
              "title": { "type": "string", "minLength": 1 },
              "schema": {
                "type": "object",
                "description": "内联 JSON Schema，驱动宿主渲染设置表单。"
              }
            }
          },
          "description": "设置贡献（RFC 0005）：schema 驱动的声明式设置项。"
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "tokens"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "主题全局唯一 ID，应该以插件 id 为前缀。"
              },
              "title": { "type": "string", "minLength": 1 },
              "tokens": {
                "type": "object",
                "propertyNames": { "pattern": "^--dsw-" },
                "description": "设计令牌映射；键必须以 --dsw- 开头。"
              },
              "dark": {
                "type": "object",
                "propertyNames": { "pattern": "^--dsw-" },
                "description": "深色模式令牌覆盖；键必须以 --dsw- 开头。"
              }
            }
          },
          "description": "主题贡献（RFC 0005）：只覆盖 --dsw-* 设计令牌，不承诺 DOM 钩子。"
        }
      },
      "description": "v0.15 定稿 contributes.commands；views / settings / themes 随 RFC 0005 引入（目标 v0.16）。"
    },
    "subscriptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "事件标识符数组；控制事件投递，不是激活触发器。"
    }
  }
}
