{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-std.example/schemas/host-descriptor/v0.15.json",
  "$comment": "字段语义以 spec/host-descriptor.md 为唯一权威来源。$id 为示意，以 Registry 定案为准。",
  "title": "Host Descriptor",
  "type": "object",
  "required": ["descriptorVersion", "id", "execution", "capabilities"],
  "properties": {
    "descriptorVersion": {
      "const": "0.15",
      "description": "Descriptor 结构版本。"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$",
      "description": "稳定、带组织命名空间的宿主 ID，反向域名语法。"
    },
    "apiVersions": {
      "type": "object",
      "properties": {
        "host": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "description": "各 facet 支持的 Host API 版本；v0.15 只规范 host facet。"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "trustMode"],
      "properties": {
        "environment": {
          "enum": ["node"],
          "description": "v0.15 只规范 Node.js 宿主侧运行时。"
        },
        "trustMode": {
          "enum": ["trusted-in-process"],
          "description": "v0.15 唯一已定义的信任档位；isolated 归后续 RFC。宿主必须显著公示该档位不构成安全边界。"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "kind"],
        "properties": {
          "apiVersion": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        }
      },
      "description": "只能声明实际实现的 registry 精确条目（apiVersion + kind 双字段齐全）。"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+-[a-z0-9]+$"
      },
      "description": "<os>-<arch> 平台标识，如 darwin-arm64；省略表示不限平台。"
    }
  }
}
